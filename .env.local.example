# Copy to .env.local and fill in.
# Project ID + dataset: sanity.io/manage → your project
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Write token for the seed script only (Editor/Write permissions).
# Create at sanity.io/manage → project → API → Tokens. Never expose publicly.
SANITY_WRITE_TOKEN=sk...

# Canonical public origin, shared by metadata, social images and sitemap.
NEXT_PUBLIC_SITE_URL=https://srinbar.com
# Set true on non-production deployments. Vercel previews are excluded automatically.
SITE_NOINDEX=false
# Optional verification tokens from Google Search Console and Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
