{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/blog/**",
              "components/core/**",
              "components/events/**",
              "components/forms/**",
              "components/marketing/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fraunces|Inter))/i]",
        "message": "Font not provided by the design system. Available: Fraunces, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gold|green|outline)$/]",
        "message": "<Badge> tone must be one of 'gold' | 'green' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BlogCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:imageUrl|category|title|excerpt|date|key|ref|className|style|children)$/]",
        "message": "<BlogCard> doesn't accept that prop. Declared props: imageUrl, category, title, excerpt, date."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|href|as|disabled|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, href, as, disabled, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|accent|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'accent' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EventCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:month|day|title|location|time|key|ref|className|style|children)$/]",
        "message": "<EventCard> doesn't accept that prop. Declared props: month, day, title, location, time."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|headline|tagline|imageUrl|primaryCta|secondaryCta|height|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: eyebrow, headline, tagline, imageUrl, primaryCta, secondaryCta, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImpactStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<ImpactStat> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='MembershipCTA'] > JSXAttribute > JSXIdentifier[name!=/^(?:headline|body|ctaLabel|key|ref|className|style|children)$/]",
        "message": "<MembershipCTA> doesn't accept that prop. Declared props: headline, body, ctaLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='Nav'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|transparent|logoText|key|ref|className|style|children)$/]",
        "message": "<Nav> doesn't accept that prop. Declared props: active, transparent, logoText."
      },
      {
        "selector": "JSXOpeningElement[name.name='Nav'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:Home|About Us|Blog|Events|Contact)$/]",
        "message": "<Nav> active must be one of 'Home' | 'About Us' | 'Blog' | 'Events' | 'Contact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NewsletterSignup'] > JSXAttribute > JSXIdentifier[name!=/^(?:headline|body|key|ref|className|style|children)$/]",
        "message": "<NewsletterSignup> doesn't accept that prop. Declared props: headline, body."
      },
      {
        "selector": "JSXOpeningElement[name.name='TeamMember'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|photoUrl|key|ref|className|style|children)$/]",
        "message": "<TeamMember> doesn't accept that prop. Declared props: name, role, photoUrl."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
